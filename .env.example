# RYO research layer (see https://ryobuild.com/docs/MCP-Builder-Guide.md)
# MCP endpoint URL from the Builder Guide / hackathon Discord
RYO_MCP_URL=
# Your RYO MCP key. NEVER commit a real value.
RYO_MCP_KEY=
# Header the key is sent in (confirm in the Builder Guide). Default: Authorization: Bearer <key>
RYO_AUTH_HEADER=Authorization
RYO_AUTH_SCHEME=Bearer

# Where scan_market puts its ranked token list, confirmed with `ryo-pulse discover`
# Syntax: dotted path, [] marks a list, e.g. candidates[].symbol
# scan_market returns data.candidates[]; each candidate's symbol field is expected at .symbol.
# If a live scan ever fails with "key 'symbol' not found", open data/catalog/scan_market.sample.json
# and put the right key here.
RYO_SCAN_TOKENS_PATH=data.candidates[].symbol
# RYO marks degraded scans in-band; these statuses are stored as failed scans, not as absence
RYO_SCAN_STATUS_PATH=status
RYO_SCAN_FAIL_STATUSES=unavailable,error,failed
# Optional: where market_overview puts the regime label, e.g. regime
RYO_OVERVIEW_REGIME_PATH=

# Local snapshot store
PULSE_DATA_DIR=data/snapshots

# Optional, only if you extend Pulse with news or an LLM (not used by the core skill)
TAVILY_API_KEY=
OPENROUTER_API_KEY=
